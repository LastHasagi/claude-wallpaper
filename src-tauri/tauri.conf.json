{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawd Pet",
  "version": "0.1.0",
  "identifier": "dev.clawdpet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Clawd, um pet de desktop que vive em cenários ASCII",
    "longDescription": "Clawd vive em cenários de ASCII art, sai em missões, traz curiosidades e reage ao mouse. Projeto de fã, não oficial.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
