{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawd Pet",
  "version": "0.5.1",
  "identifier": "dev.clawdpet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Clawd Pet, um pet de desktop em cenários ASCII, por Rodrigo Graça",
    "longDescription": "Clawd vive em cenários de ASCII art, sai em missões, traz curiosidades e reage ao mouse. Criado por Rodrigo Graça (github.com/LastHasagi · linkedin.com/in/rodrigo-de-souza-graca).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "publisher": "Rodrigo Graça",
    "copyright": "Copyright (c) 2026 Rodrigo Graça",
    "homepage": "https://github.com/LastHasagi/claude-wallpaper",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRjRBODFCNkMxMzc3MDQKUldRRWR4TnNHNmowV2xEeWk0N1pSYitUOEZ6L2Y5VXpSaWN3aXVMV2JuU2F2aXVUM3FHS0phTkYK",
      "endpoints": ["https://github.com/LastHasagi/claude-wallpaper/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
