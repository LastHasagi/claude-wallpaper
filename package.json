{
  "name": "clawd-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clawd, um pet de desktop que vive em cenários ASCII e sai em missões.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-shots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "rollup": "4.62.0"
  }
}
