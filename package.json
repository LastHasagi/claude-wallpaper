{
  "name": "clawd-pet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Clawd, um pet de desktop que vive em cenários ASCII e sai em missões.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-shots.mjs",
    "tauri": "tauri",
    "icon": "node scripts/make-icon.mjs artifacts/icon.png && tauri icon artifacts/icon.png",
    "gif": "vite build && node scripts/make-gif.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.20.5",
    "gifenc": "1.0.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "rollup": "4.62.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Rodrigo Graça (https://github.com/LastHasagi)",
  "homepage": "https://github.com/LastHasagi/claude-wallpaper",
  "repository": {
    "type": "git",
    "url": "https://github.com/LastHasagi/claude-wallpaper.git"
  }
}
